# Node / TypeScript  (web-shell/, backend/, reader-engine/)
# ---------------------------------------------------------------------------
node_modules/
dist/
coverage/
.nyc_output/
*.tsbuildinfo
.npm/

# ---------------------------------------------------------------------------
# Rust  (core-rust/)
# ---------------------------------------------------------------------------
target/
# DECISIÓN: Cargo.lock SÍ se versiona. Este proyecto construye un producto final
# (no una librería publicada en crates.io) y la reproducibilidad importa para
# poder compilar en hardware de gama baja con versiones conocidas y estables.
# Si algún crate de core-rust llega a publicarse como librería, se invierte.

